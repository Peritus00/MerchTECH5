{
  "CORSRules": [
    {
      "AllowedHeaders": [
        "*"
      ],
      "AllowedMethods": [
        "GET",
        "HEAD"
      ],
      "AllowedOrigins": [
        "http://localhost:8081",
        "http://localhost:3000",
        "https://localhost:8081",
        "https://app.merchtech.net",
        "https://merchtech.net",
        "https://*.merchtech.net"
      ],
      "ExposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Type",
        "Accept-Ranges"
      ],
      "MaxAgeSeconds": 3600
    }
  ]
} 