{
  "version": 2,
  "builds": [
    {
      "src": "dist/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "services/Server/main.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "services/Server/main.js"
    },
    {
      "src": "/favicon\\.ico$",
      "dest": "dist/favicon.ico",
      "headers": {
        "Cache-Control": "public, max-age=31536000",
        "Content-Type": "image/x-icon"
      }
    },
    {
      "src": "/favicon-([0-9]+)x([0-9]+)\\.png$",
      "dest": "dist/favicon-$1x$2.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000",
        "Content-Type": "image/png"
      }
    },
    {
      "src": "/favicon\\.png$",
      "dest": "dist/favicon.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000",
        "Content-Type": "image/png"
      }
    },
    {
      "src": "/_expo/(.*)",
      "dest": "dist/_expo/$1"
    },
    {
      "src": "^/$",
      "dest": "dist/auth/login.html"
    },
    {
      "src": "/auth/login",
      "dest": "dist/auth/login.html"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))$",
      "dest": "dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "dist/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "EXPO_PUBLIC_NODE_ENV": "production",
    "EXPO_PUBLIC_API_URL": "https://merchtech5-production.up.railway.app/api"
  }
} 