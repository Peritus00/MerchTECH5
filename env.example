# Environment Configuration Template
# Copy this file to .env and update with your actual values

# =============================================================================
# API CONFIGURATION
# =============================================================================
EXPO_PUBLIC_API_URL=http://localhost:5001/api

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/merchtech_db

# =============================================================================
# AWS S3 CONFIGURATION (Optional - for media file storage)
# =============================================================================
# AWS credentials for S3 file storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=merchtech-media-files

# =============================================================================
# STRIPE CONFIGURATION (Test Keys)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================================================
# EMAIL CONFIGURATION (Brevo/SendinBlue)
# =============================================================================
BREVO_SMTP_KEY=your_brevo_smtp_key_here
BREVO_API_KEY=your_brevo_api_key_here

# =============================================================================
# SECURITY
# =============================================================================
JWT_SECRET=your_super_secure_jwt_secret_here_change_in_production

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=5001
NODE_ENV=development

# Dedupe settings for QR scans (seconds)
SCAN_DEDUP_WINDOW_SECONDS=60

# =============================================================================
# FRONTEND CONFIGURATION (for email links)
# =============================================================================
FRONTEND_URL=http://localhost:8081

# =============================================================================
# EXPO CONFIGURATION
# =============================================================================
EXPO_PROJECT_ID=your-expo-project-id-here

# =============================================================================
# GEOLOCATION PROVIDER (Optional - for accurate city/region analytics)
# =============================================================================
# Options: 'ipinfo' or 'ipdata'
# If not configured, the system falls back to:
#   1. Cloud provider headers (Cloudflare, Vercel, etc.) - usually only country
#   2. geoip-lite local database - often missing city data
# 
# With a provider configured, you get accurate city/region for analytics
# 
# ipinfo.io (Recommended):
#   - Free: 50,000 requests/month
#   - Sign up: https://ipinfo.io/signup
#   - Get token: https://ipinfo.io/account/token
#
# ipdata.co (Alternative):
#   - Free: 1,500 requests/day (~45,000/month)
#   - Sign up: https://ipdata.co/sign-up.html
#
GEO_PROVIDER=ipinfo
GEO_API_KEY=your_ipinfo_api_token_here

# =============================================================================
# SOCIAL LOGIN CONFIGURATION (Google & Apple)
# =============================================================================
# Google OAuth - Android Client ID (for backend token verification)
GOOGLE_CLIENT_ID=587879962618-t2oo5ltqmelojee6gotjku4l8sin495p.apps.googleusercontent.com

# Apple OAuth - Service ID from Apple Developer Portal
APPLE_CLIENT_ID=com.peritus00.merchtech.signin
APPLE_SERVICE_ID=com.peritus00.merchtech.signin
APPLE_TEAM_ID=4F996CU4LJ
# Apple Private Key for OAuth code exchange (web only)
# Get from Apple Developer Portal > Keys > Sign in with Apple key
# Format: Multi-line PEM key (-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----)
APPLE_KEY_ID=your_apple_key_id_here
APPLE_PRIVATE_KEY=your_apple_private_key_here

# Mobile app Google OAuth - Use Android Client ID
# Note: This should be set in .env or app.config.js for Expo
EXPO_PUBLIC_GOOGLE_CLIENT_ID=587879962618-t2oo5ltqmelojee6gotjku4l8sin495p.apps.googleusercontent.com

# Apple Sign-In - Service ID for web and mobile
# Note: This should be set in .env or app.config.js for Expo
EXPO_PUBLIC_APPLE_CLIENT_ID=com.peritus00.merchtech.signin
EXPO_PUBLIC_APPLE_SERVICE_ID=com.peritus00.merchtech.signin

# =============================================================================
# PRODUCTION NOTES:
# =============================================================================
# For production deployment:
# 1. Change all localhost URLs to your production domain
# 2. Use HTTPS instead of HTTP
# 3. Update Stripe keys to live keys (sk_live_... and pk_live_...)
# 4. Use a strong, unique JWT_SECRET
# 5. Set NODE_ENV=production
# 6. Update EXPO_PROJECT_ID with your actual project ID
# 7. Configure AWS S3 for media file storage (recommended for production)
# 8. Configure GEO_PROVIDER for accurate city-level analytics (optional)
# 9. Add SHA-1 fingerprint to Google Android OAuth client for production keystore 