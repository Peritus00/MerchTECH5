{
  "version": 2,
  "builds": [
    {
      "src": "services/Server/main.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "services/Server/main.js"
    },
    {
      "src": "/_expo/(.*)",
      "dest": "/dist/_expo/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
} 