{
  "CORSRules": [
    {
      "AllowedHeaders": [
        "*"
      ],
      "AllowedMethods": [
        "GET",
        "HEAD"
      ],
      "AllowedOrigins": [
        "http://localhost:8081",
        "http://localhost:3000",
        "https://localhost:8081",
        "https://app.merchtrader.org",
        "https://merchtrader.org",
        "https://*.merchtrader.org"
      ],
      "ExposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Type",
        "Accept-Ranges"
      ],
      "MaxAgeSeconds": 3600
    }
  ]
} 