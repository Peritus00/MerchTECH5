{
  "cli": {
    "version": ">= 16.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "587879962618-t2oo5ltqmelojee6gotjku4l8sin495p.apps.googleusercontent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "587879962618-t2oo5ltqmelojee6gotjku4l8sin495p.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "587879962618-t2oo5ltqmelojee6gotjku4l8sin495p.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
