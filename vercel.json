{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/_expo/(.*)",
      "dest": "/_expo/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "EXPO_PUBLIC_NODE_ENV": "production",
    "EXPO_PUBLIC_API_URL": "https://merchtech5-production.up.railway.app/api",
    "CACHE_BUST": "20250714-03-s3keys-updated"
  }
} 