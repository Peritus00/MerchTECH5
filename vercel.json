{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/favicon\\.ico$",
      "dest": "/favicon.ico",
      "headers": {
        "Cache-Control": "public, max-age=31536000",
        "Content-Type": "image/x-icon"
      }
    },
    {
      "src": "/favicon-([0-9]+)x([0-9]+)\\.png$",
      "dest": "/favicon-$1x$2.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000",
        "Content-Type": "image/png"
      }
    },
    {
      "src": "/favicon\\.png$",
      "dest": "/favicon.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000",
        "Content-Type": "image/png"
      }
    },
    {
      "src": "/_expo/(.*)",
      "dest": "/_expo/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))$",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Content-Security-Policy": "default-src 'self'; img-src 'self' data: https://*.amazonaws.com https://www.merchtrader.org https://merchtrader.org https://merchtech5-production.up.railway.app; connect-src 'self' data: https://merchtech5-production.up.railway.app https://www.merchtrader.org https://merchtrader.org https://*.amazonaws.com https://*.stripe.com https://api.brevo.com https://app.termly.io https://us.consent.api.termly.io; media-src 'self' https://merchtech5-production.up.railway.app https://*.amazonaws.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.stripe.com https://app.termly.io; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
      }
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "EXPO_PUBLIC_NODE_ENV": "production",
    "EXPO_PUBLIC_API_URL": "https://merchtech5-production.up.railway.app/api",
    "EXPO_PUBLIC_FRONTEND_URL": "https://www.merchtrader.org",
    "FRONTEND_URL": "https://www.merchtrader.org",
    "CACHE_BUST": "20250120-AUDIO-PICKER-DEBUG-FORCE"
  }
} 