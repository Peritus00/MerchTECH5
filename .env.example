
# Server Configuration
PORT=5001

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key

# Email Service (Brevo)
BREVO_API_KEY=your-brevo-api-key

# API URLs - Use your current Replit domain
API_BASE_URL=https://your-repl-domain.kirk.replit.dev/api
EXPO_PUBLIC_API_URL=https://your-repl-domain.kirk.replit.dev/api

# Stripe Configuration (Use live keys for production)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Stripe Shipping Rates (optional)
# If set, these Stripe shipping rate IDs are used instead of the inline defaults.
# Create them in your Stripe Dashboard → Products → Shipping Rates.
# If NOT set, the server will create inline rates ($5.99 Standard / $14.99 Express).
# STRIPE_SHIPPING_RATE_FREE=shr_xxxxxxxxxxxxxxxx
# STRIPE_SHIPPING_RATE_STANDARD=shr_xxxxxxxxxxxxxxxx
# STRIPE_SHIPPING_RATE_EXPRESS=shr_xxxxxxxxxxxxxxxx

# For development, use test keys:
# STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here  
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key_here
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key_here

# Deployment Configuration
NODE_ENV=production
REPLIT_DEV_DOMAIN=your-repl-name.replit.app

# Node Environment
NODE_ENV=development
